# --- GENERAL APP SETTINGS ---
PORT="5000"
NODE_ENV="development" # Ubah ke "production" jika deploy di server/Railway

# --- DATABASE & SESSION ---
# DATABASE_URL biasanya sudah otomatis di set oleh platform seperti Railway jika pakai fitur Postgres
DATABASE_URL="postgresql://..." 
SESSION_SECRET="random-secret-min-32-char-bebas"
# USER_JWT_SECRET="opsional-jika-kosong-otomatis-pakai-session-secret"

# --- DISCORD BOT INTEGRATION ---
# Secret ini digunakan untuk endpoint /api/reset-hwid, /api/generate-key, /api/revoke-key
# Wajib SAMA dengan nilai BOT_SECRET di file .env milik bot Discord lu.
BOT_SECRET="isi_dengan_secret_rahasia_untuk_bot"

# --- CASAKU PAYMENT GATEWAY ---
CASAKU_LICENSE="isi_dengan_license_key_casaku_lu"
CASAKU_QRIS_ID="isi_dengan_qris_id_casaku_lu"
CASAKU_WEBHOOK_SECRET="isi_dengan_webhook_secret_casaku_lu"
# (Opsional - default sudah bagus) 
CASAKU_PACKAGE_IDS="id.dana,com.shopee.id"
CASAKU_EXPIRED_MINUTES="15"
CASAKU_USE_UNIQUE_CODE="true"

# --- RESEND EMAIL NOTIFICATIONS ---
# Digunakan untuk notifikasi ke email jika ada order atau pendaftaran
RESEND_API_KEY="re_xxxxxxxx_xxxxxxxxxxxxxxxxx"

# --- CLOUDFLARE R2 (AVATAR UPLOAD) ---
R2_ACCOUNT_ID="account_id_cloudflare_lu"
R2_ACCESS_KEY_ID="access_key_r2"
R2_SECRET_ACCESS_KEY="secret_key_r2"
R2_BUCKET_NAME="nama_bucket_lu"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxx.r2.dev"
